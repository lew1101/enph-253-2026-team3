CompileFlags:
  Add:
    - "-D__xtensa__"
    - "-DESP32"
    - "-DESP_PLATFORM"
  Remove:
    - "-mlongcalls"
    - "-fno-shrink-wrap"
    - "-fstrict-volatile-bitfields"
    - "-fno-tree-switch-conversion"
    - "-mdisable-hardware-atomics"
    - "-fstrict-volataile-bitfields"
    - "-mfix-esp32-psram-cache-issue"
    - "-mfix-esp32-psram-cache-strategy=memw"

Diagnostics:
  Suppress:
    - "drv_unknown_argument*"

InlayHints:
  Enabled: true

Hover:
  ShowAKA: true
